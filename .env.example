# Copy to .env and fill locally. Never commit real keys.
DEEPSEEK_API_KEY=

BGE_EMBEDDING_MODEL_PATH=models/bge-m3
BGE_RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
BGE_DEVICE=auto
BGE_EMBEDDING_DEVICE=cuda:0
BGE_RERANKER_DEVICE=cuda:1
BGE_EMBEDDING_BATCH_SIZE=32
BGE_RERANKER_BATCH_SIZE=16
BGE_RERANKER_MAX_LENGTH=512
BGE_DTYPE=float16
EMBEDDING_CACHE_DIR=data/cache/embeddings
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_EXTRACTION_MAX_TOKENS=8192
DEEPSEEK_RETRY_INITIAL_SECONDS=1
DEEPSEEK_RETRY_MAX_SECONDS=60
DEEPSEEK_MAX_ATTEMPTS=8
DEEPSEEK_MAX_CONCURRENCY=32
DEEPSEEK_POOL_MAX_CONNECTIONS=48
DEEPSEEK_POOL_KEEPALIVE_CONNECTIONS=32
DEEPSEEK_RESPONSE_CACHE_DIR=data/cache/deepseek
EXTRACTION_BATCH_MAX_CHARS=24000
EXTRACTION_WORKERS=8
BENCHMARK_EXAMPLE_WORKERS=8
GENERATION_WORKERS=8
CHECKPOINT_EVERY=25
